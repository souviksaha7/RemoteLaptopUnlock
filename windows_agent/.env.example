# Configuration for Remote Laptop Biometric Unlock (Windows Agent)
# Store this file as .env in the same directory as agent.py

# Shared Bearer Token used to authenticate requests from the Android app
SECRET_TOKEN=change_this_to_a_secure_token_123456

# If your Windows PC asks for a PIN (Windows Hello PIN, e.g. 1234), set it here:
WINDOWS_PIN=

# If your Windows PC asks for an account password instead of a PIN, set it here:
WINDOWS_PASSWORD=

# HTTP API server port (default: 5000)
HTTP_PORT=5000

# UDP beacon port for LAN discovery (default: 5005)
UDP_PORT=5005

# Number of UDP discovery beacons to broadcast on startup
BROADCAST_COUNT=5

# Interval in seconds between UDP discovery beacons
BROADCAST_INTERVAL=2.0

# Initial delay in seconds before broadcasting beacons (gives network time to connect)
BROADCAST_INITIAL_DELAY=3.0
